# Flags khusus untuk Antarmuka TWRP (Realme C53)
# backup=flashimg memungkinkan partisi logical erofs dipilih di Backup &
# Install Image (partition.cpp/partitionmanager.cpp di-patch via build.yml;
# tanpa patch itu TWRP mengunci Can_Be_Backed_Up=false di Prepare_Super_Volume).
# #264: flag backup=1/flashimg DILEPAS dari recovery.fstab agar libfs_mgr
# (init/TWRP) dan libfstab (vold/boot-hal) tidak memperingatkan flag tak
# dikenal; fitur backup+install image dipertahankan via entri di sini.
/system           erofs     /dev/block/mapper/system            flags=display="System";logical;slotselect;backup=1;flashimg
/system_ext       erofs     /dev/block/mapper/system_ext        flags=display="System EXT";logical;slotselect;backup=1;flashimg
/vendor           erofs     /dev/block/mapper/vendor            flags=display="Vendor";logical;slotselect;backup=1;flashimg
/product          erofs     /dev/block/mapper/product           flags=display="Product";logical;slotselect;backup=1;flashimg
/odm              erofs     /dev/block/mapper/odm               flags=display="ODM";logical;slotselect;backup=1;flashimg
/vendor_dlkm      erofs     /dev/block/mapper/vendor_dlkm       flags=display="Vendor DLKM";logical;slotselect;backup=1;flashimg;wipeingui
/system_dlkm      erofs     /dev/block/mapper/system_dlkm       flags=display="System DLKM";logical;slotselect;backup=1;flashimg

# Partisi fisik yang sebelumnya memegang backup=1/flashimg langsung di
# recovery.fstab (dipindah ke sini pada #264 agar warning libfs_mgr hilang).
/dtbo             emmc      /dev/block/by-name/dtbo             flags=display="DTBO";slotselect;backup=1;flashimg
/vendor_boot      emmc      /dev/block/by-name/vendor_boot      flags=display="Vendor Boot";slotselect;backup=1;flashimg

# Storage Tambahan
/usb_otg          vfat      /dev/block/sda1                     flags=display="USB-OTG";storage;removable;wipeingui;backup=1
/external_sd      vfat      /dev/block/mmcblk1p1                flags=display="MicroSD";storage;wipeingui;removable
