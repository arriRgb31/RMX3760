# Flags khusus untuk Antarmuka TWRP (Realme C53)
/system           erofs     /dev/block/mapper/system            flags=display="System";logical;slotselect;backup=1
/system_ext       erofs     /dev/block/mapper/system_ext        flags=display="System EXT";logical;slotselect;backup=1
/vendor           erofs     /dev/block/mapper/vendor            flags=display="Vendor";logical;slotselect;backup=1
/product          erofs     /dev/block/mapper/product           flags=display="Product";logical;slotselect;backup=1
/odm              erofs     /dev/block/mapper/odm               flags=display="ODM";logical;slotselect;backup=1
/vendor_dlkm      erofs     /dev/block/mapper/vendor_dlkm       flags=display="Vendor DLKM";logical;slotselect;backup=1;wipeingui

# Storage Tambahan
/usb_otg          vfat      /dev/block/sda1                     flags=display="USB-OTG";storage;removable;wipeingui;backup=1
/external_sd      vfat      /dev/block/mmcblk1p1                flags=display="MicroSD";storage;wipeui;removable
