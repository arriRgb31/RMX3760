# keymint_unisoc.rc — start Unisoc Trusty gatekeeper + keymint HALs in TWRP
# hal-boot mounts vendor with wait-loop, fixes VINTF, harvests VNDK,
# restarts SM + keymint + keystore2, triggers twrp.halstart=1.
# Auto-start via `on late-init` (same trigger keystore2.rc uses; proven to
# fire after all rc files are parsed, unlike class_start recovery which ran
# before this rc was parsed).

on late-init
    stop keystore2
    # stock rc starts vendor.sprd.boot-hal-1-2 (class early_hal) but it crashes
    # without A15 libbase (CANNOT LINK Tokenize); hal_boot re-runs the same
    # binary via vendor.sprd.boot-hal-ice which carries the harvested libbase
    # in LD_LIBRARY_PATH, so ICE/FDE keys get provisioned.
    stop vendor.sprd.boot-hal-1-2
    start hal-boot

service hal-boot /system/bin/sh /system/bin/hal_boot.sh
    class late_start
    user root
    group root system
    oneshot
    seclabel u:r:su:s0

service vendor.sprd.boot-hal-ice /vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service
    class late_start
    user root
    group root
    setenv LD_LIBRARY_PATH /tmp/harvest/libbase64:/vendor/lib64:/vendor/lib64/hw:/system/lib64
    seclabel u:r:su:s0

service vendor.gatekeeper-trusty /vendor/bin/hw/android.hardware.gatekeeper@1.0-service.trusty
    class late_start
    user root
    group root system drmrpc
    setenv LD_LIBRARY_PATH /tmp/harvest/vndk:/vendor/lib64:/system/lib64
    seclabel u:r:su:s0

service vendor.keymint-unisoc /vendor/bin/hw/android.hardware.security.keymint@2.0-unisoc.service.trusty
    class late_start
    user root
    group root system drmrpc
    setenv LD_LIBRARY_PATH /tmp/harvest/vndk:/vendor/lib64:/system/lib64
    seclabel u:r:su:s0

on property:twrp.halstart=1
    start vendor.gatekeeper-trusty
    start vendor.keymint-unisoc

# vold — stock A15 vold to create dm-default-key("userdata") and unlock/mount
# /data in TWRP. The 4 --*=context args are MANDATORY (stock vold.rc); without
# them vold aborts at main.cpp parse_args CHECK (SIGABRT 134, silent).
# LD_LIBRARY_PATH order matters: harvested A15 libc (memset_explicit) first,
# then VNDK/harvest dir, then stock A15 system libs (system_root), vendor,
# then ramdisk. Started last by hal_boot (after chain + servicemanager.ready).
service vold /system_root/system/bin/vold \
        --blkid_context=u:r:blkid:s0 --blkid_untrusted_context=u:r:blkid_untrusted:s0 \
        --fsck_context=u:r:fsck:s0 --fsck_untrusted_context=u:r:fsck_untrusted:s0
    class late_start
    user root
    group root
    disabled
    setenv LD_LIBRARY_PATH /tmp/harvest/voldlibs:/tmp/harvest/vndk:/system/lib64/a15:/system_root/system/lib64:/vendor/lib64:/system_ext/lib64:/system/lib64
    seclabel u:r:su:s0

on property:twrp.voldstart=1
    start vold
