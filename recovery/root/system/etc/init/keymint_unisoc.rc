# keymint_unisoc.rc — start Unisoc Trusty gatekeeper + keymint HALs in TWRP
# ---------------------------------------------------------------- trigger ----
# hal-boot is now DYNAMIC GLUE ONLY (VINTF neutralization, lib harvest,
# keystore2 registration wait, fstab staging). Everything static/declarative
# lives here in init.rc:
#   - active-slot system/system_ext mount (ro) so stock vold/vdc are reachable
#   - vold + vold-direct fallback services (single-line args, no continuation)
#   - metadata mount before vold start (keydirectory=/metadata/vold/...)
# Auto-start via `on late-init` (proven to fire after all rc files parsed).

# Touch latency killer: omnivision_tcm_spi floods dmesg with ~125 printk
# (KERN_INFO "TP_interface/I") per second while a finger is down -> 115200 baud
# console (ttyS1) saturates -> kernel stalls for seconds. Lower console_loglevel
# under NOTICE so INFO flood is never written to the serial console; the dmesg
# ring buffer still keeps every line for debugging.
on early-init
    write /proc/sys/kernel/printk 5 4 1 7

on late-init
    stop keystore2
    # stock rc starts vendor.sprd.boot-hal-1-2 (class early_hal) but it crashes
    # without A15 libbase (CANNOT LINK Tokenize); hal_boot re-runs the same
    # binary via vendor.sprd.boot-hal-ice which carries the harvested libbase
    # in LD_LIBRARY_PATH, so ICE/FDE keys get provisioned.
    stop vendor.sprd.boot-hal-1-2
    # stock vold/vdc live on the active system partition; recovery does not
    # mount it. init `mount` waits for the node; ${:-_a} default covers boot
    # slots where init never wired ro.boot.slot_suffix (cf. lpdumpd.rc).
    mkdir /system_root
    mkdir /system_ext
    mount erofs erofs /dev/block/mapper/system${ro.boot.slot_suffix:-_a} /system_root ro
    mount erofs erofs /dev/block/mapper/system_ext${ro.boot.slot_suffix:-_a} /system_ext ro
    start hal-boot

service hal-boot /system/bin/sh /system/bin/hal_boot.sh
    class late_start
    user root
    group root system
    oneshot
    # recovery domain is permissive here (proven by keystore2: avc lines with
    # permissive=1); vdc (child of hal_boot) inherits it so `vdc mount-all` can
    # find/transact the "vold" service once registered.
    seclabel u:r:recovery:s0

service vendor.sprd.boot-hal-ice /vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service
    class late_start
    user root
    group root
    setenv LD_LIBRARY_PATH /tmp/harvest/libbase64:/vendor/lib64:/vendor/lib64/hw:/system/lib64
    seclabel u:r:su:s0

service vendor.gatekeeper-trusty /vendor/bin/hw/android.hardware.gatekeeper@1.0-service.trusty
    class late_start
    user root
    group root system drmrpc
    setenv LD_LIBRARY_PATH /tmp/harvest/vndk:/vendor/lib64:/system/lib64
    seclabel u:r:su:s0

service vendor.keymint-unisoc /vendor/bin/hw/android.hardware.security.keymint@2.0-unisoc.service.trusty
    class late_start
    user root
    group root system drmrpc
    setenv LD_LIBRARY_PATH /tmp/harvest/vndk:/vendor/lib64:/system/lib64
    seclabel u:r:su:s0

on property:twrp.halstart=1
    start vendor.gatekeeper-trusty
    start vendor.keymint-unisoc

# vold — stock A15 vold creates dm-default-key("userdata") for /data unlock.
# The 4 --*=context args are MANDATORY (stock vold.rc; without them vold aborts
# at main.cpp parse_args CHECK, SIGABRT). Single line on purpose: the previous
# multi-line `\` continuation never registered the service in this init.
# LD_LIBRARY_PATH order matters: harvested A15 libc/memset_explicit first, then
# VNDK/harvest, then stock A15 system libs (system_root), vendor, system_ext.
service vold /system_root/system/bin/vold --blkid_context=u:r:blkid:s0 --blkid_untrusted_context=u:r:blkid_untrusted:s0 --fsck_context=u:r:fsck:s0 --fsck_untrusted_context=u:r:fsck_untrusted:s0
    class late_start
    user root
    group root
    disabled
    setenv LD_LIBRARY_PATH /tmp/harvest/voldlibs:/tmp/harvest/vndk:/system/lib64/a15:/system_root/system/lib64:/vendor/lib64:/system_ext/lib64:/system/lib64
    # u:r:su:s0 was non-permissive -> "Unable to start VoldNativeService"
    # (binder addService("vold") to servicemanager). recovery domain is
    # permissive AND is the exact domain keystore2 uses when it successfully
    # registers its service in this build.
    seclabel u:r:recovery:s0

# vold-direct: same binary/args, init-managed fallback started by hal_boot iff
# the property-triggered `vold` did not come up (protects against a parser-level
# failure of the service block above).
service vold-direct /system_root/system/bin/vold --blkid_context=u:r:blkid:s0 --blkid_untrusted_context=u:r:blkid_untrusted:s0 --fsck_context=u:r:fsck:s0 --fsck_untrusted_context=u:r:fsck_untrusted:s0
    class late_start
    user root
    group root
    disabled
    oneshot
    setenv LD_LIBRARY_PATH /tmp/harvest/voldlibs:/tmp/harvest/vndk:/system/lib64/a15:/system_root/system/lib64:/vendor/lib64:/system_ext/lib64:/system/lib64
    seclabel u:r:recovery:s0

on property:twrp.voldstart=1
    # stock /data needs /metadata mounted (keydirectory=/metadata/vold/...)
    mkdir /metadata
    mount f2fs /dev/block/by-name/metadata /metadata rw
    # servicemanager auto-starts via class core (before late_start vold)
    start vold