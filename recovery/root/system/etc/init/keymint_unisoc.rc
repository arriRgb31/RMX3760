# keymint_unisoc.rc - self-contained A15 crypto stack for TWRP (RMX3760/UMS9230)
# ----------------------------------------------------------------------
# DESIGN (final, overlay-proof):
#   All stock A15 crypto binaries + their full ELF lib closures are baked into
#   the RAMDISK ROOT at /crypto/ (never shadowed: /system, /vendor, /odm,
#   /system_ext, /product get overlaid by the stock partitions shortly after
#   boot). No partition mount is required for the stack; the 4 required vold
#   context args are baked into the service line (single-line, no `\`).
#   VINTF: the stock /system/etc/vintf and /vendor/etc/vintf trees are baked
#   into the ramdisk so hwservicemanager/servicemanager accept our AIDL HAL
#   registration (IKeyMintDevice/ISecureClock/ISharedSecret/default) before
#   the stock /system + /vendor partitions are overlaid.
#   ORDERING (CRITICAL, #253): A15 vold aborts (~80ms into late-init) if the
#   super logical partition system_b is not mapped yet; TWRP's recovery process
#   creates /dev/block/mapper/system_b right after late-init begins. NEVER block
#   init's action queue with `wait` here: #252 proved it stalls late-init (and
#   hence recovery startup) for the full 30s ("stuck at logo") while making the
#   race WORSE (wait timed out 77ms BEFORE TWRP mapped system_b). Instead we run
#   a non-blocking oneshot (vold-mapper-wait) that polls for the device node and
#   then raises sys.crypto.mapper.ready=1; the property trigger below starts
#   vold-unisoc (then keystore2-unisoc) only once the mapper actually exists.
#   keystore2-unisoc observes vold's fbe states + reuses the AIDL
#   android.system.keystore2 contract consistently with the A15 stack.
#   SIGSEGV diagnosis (#254-255): TWRP's A12.1 init has no sredirect_* and an
#   LD_PRELOAD sigcatch probe coincided with the first crash-loop; both removed.
#   The kernel print-fatal-signals=1 path logs the faulting PC/address instead.
#   The A12.1 built-in keystore2 is fully disabled via a no-op keystore2.rc:
#   it can't parse the A15 VINTF v5.0 tree (libvintf@4.0 -> SIGSEGV crash-loop)
#   and races this service for android.system.keystore2.
#   vdc: A15 removed `vdc mount-all`; the modern invocation is
#   `vdc cryptfs mountFstab <fstab> <earlyMount> <isZoned> <userDevices>`.
#   We pass the ramdisk fstab.ums9230_hulk (metadata+userdata only), which
#   also sidesteps the DT-fstab logical-partition probe in vold.
#   /odm hold (#262): TWRP mounts /odm erofs (dm-4) then drops it in
#   "Unmounting main partitions..." (only /vendor survives because it stays
#   busy). With /odm gone, servicemanager follows ramdisk symlink
#   /odm/etc -> /vendor/odm/etc onto the *live vendor mount*, which has its
#   own odm -> /vendor/odm -> ELOOP "Too many symbolic links" => NULL VINTF
#   MANIFEST => keymint trusty SIGABRT loop => keystore2 panic. odm-mount-hold
#   remounts the real erofs /odm and parks its cwd inside so TWRP unmount
#   fails EBUSY (exactly how /vendor survives). Non-blocking poll (#253).

on early-init
    # Touch latency killer: keep kernel INFO flooding off the 115200 serial
    # console; dmesg ring buffer still keeps every line for debugging.
    write /proc/sys/kernel/printk "5 4 1 7"
    # SIGSEGV diagnosis without sigcatch: kernel will log the faulting address
    # + PC + registers for every fatal signal (print-fatal-signals=1).
    write /proc/sys/kernel/print-fatal-signals 1
    # keystore2 workspace (created before /data is mounted)
    mkdir /data/misc/keystore 0700 keystore keystore
    # ftrace signal_generate: capture the KERNEL's view of the triple SIGSEGV
    # (sender -> target -> signum). No "segfault at" reaches dmesg and libc's
    # "Fatal signal 11" never prints, so trace who actually delivers it. Set up
    # in early-init so it is live BEFORE the first crash on late-init. #253
    mkdir /sys/kernel/debug
    mount tracefs tracefs /sys/kernel/debug/tracing none
    write /sys/kernel/debug/tracing/set_event signal_generate
    write /sys/kernel/debug/tracing/tracing_on 1

on boot
    install_keyring
    start crypto-diag

on late-init
    # vold keydir lives on /metadata (keydirectory=/metadata/vold/...)
    # (f2fs first; ext4 fallback on pre-formatted eMMC builds)
    mount f2fs /dev/block/by-name/metadata /metadata rw
    mount ext4 /dev/block/by-name/metadata /metadata rw
    # CRITICAL (#253): A15 vold hard-fails on unmapped super logical partitions.
    # TWRP creates /dev/block/mapper/system_b shortly after late-init starts.
    # Do NOT `wait` here: #252 proved it stalls late-init (and recovery startup)
    # for the full 30s ("stuck at logo") while timing out 77ms BEFORE TWRP
    # mapped system_b - it only made the race worse. Instead, a non-blocking
    # oneshot polls for the node and raises sys.crypto.mapper.ready=1.
    start vold-mapper-wait
    # #262: keep /odm (erofs dm-4) mounted + busy before the crypto stack
    # starts; without it servicemanager VINTF parse hits the /odm symlink
    # loop and keymint SIGABRT-loops (see header). Parallel, non-blocking.
    start odm-mount-hold

# ---- vold/keystore2: only after TWRP maps system_b (non-blocking) ----
on property:sys.crypto.mapper.ready=1
    start vendor.sprd.boot-hal-ice
    start vendor.keymint-unisoc
    start vendor.gatekeeper-trusty
    start vold-unisoc
    # keystore2 after vold: it observes vold's fbe states + reuses the AIDL
    # android.system.keystore2 contract consistently with the A15 stack.
    start keystore2-unisoc

# ---- vold unlock: run once keymint/keystore2 registered + vold is up ----
on property:init.svc.vold-unisoc=running && property:init.svc.keystore2-unisoc=running && property:init.svc.vendor.keymint-unisoc=running
    start vdc-mount-all

on property:ro.crypto.state=unsupported
    stop vendor.keymint-unisoc
    stop vendor.gatekeeper-trusty
on property:ro.crypto.state=unencrypted
    stop vendor.keymint-unisoc
    stop vendor.gatekeeper-trusty
on property:twrp.decrypt.done=true
    stop vendor.keymint-unisoc
    stop vendor.gatekeeper-trusty

service vold-mapper-wait /system/bin/sh /crypto/bin/sys/vold_mapper_wait.sh
    user root
    group root
    oneshot
    seclabel u:r:recovery:s0

# #262: poll /dev/block/dm-4 (odm logical partition), remount the real erofs
# /odm and park cwd inside to keep it busy, so TWRP's "Unmounting main
# partitions..." fails EBUSY for /odm exactly like it does for /vendor.
# Survives until init tears the namespace down. Never oneshot.
service odm-mount-hold /system/bin/sh /crypto/bin/sys/odm_mount_hold.sh
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service vendor.keymint-unisoc /crypto/bin/vendor/android.hardware.security.keymint@2.0-unisoc.service.trusty
    user root
    group root drmrpc
    disabled
    setenv LD_LIBRARY_PATH /crypto/lib/vendor:/crypto/lib/system
    seclabel u:r:recovery:s0

service vendor.gatekeeper-trusty /crypto/bin/vendor/android.hardware.gatekeeper@1.0-service.trusty
    user root
    group root
    disabled
    setenv LD_LIBRARY_PATH /crypto/lib/vendor:/crypto/lib/system
    seclabel u:r:recovery:s0

service vendor.sprd.boot-hal-ice /crypto/bin/vendor/vendor.sprd.hardware.boot@1.2-service
    user root
    group root
    disabled
    setenv LD_LIBRARY_PATH /crypto/lib/vendor:/crypto/lib/system
    seclabel u:r:recovery:s0

service keystore2-unisoc /crypto/bin/sys/keystore2 /data/misc/keystore
    user root
    group root readproc log
    rlimit memlock unlimited unlimited
    disabled
    setenv LD_LIBRARY_PATH /crypto/lib/system
    seclabel u:r:recovery:s0

service vold-unisoc /crypto/bin/sys/vold --blkid_context=u:r:blkid:s0 --blkid_untrusted_context=u:r:blkid_untrusted:s0 --fsck_context=u:r:fsck:s0 --fsck_untrusted_context=u:r:fsck_untrusted:s0
    user root
    group root reserved_disk
    disabled
    setenv LD_LIBRARY_PATH /crypto/lib/system
    seclabel u:r:recovery:s0

# A15 vdc: legacy `vdc mount-all` is GONE.
# Modern A15: vdc cryptfs mountFstab <blkDevice> <mountPoint> <isZoned> <userDevices>
#   args.size()==6 -> VoldNativeService::mountFstab(args[2], args[3], isZoned, userDevices)
#   (A14.1 differs: 5 args blk/mount/zoned; A15 added userDevices at index 5)
# blkDevice/userdata + /data -> fscrypt_mount_metadata_encrypted: read_key from
# fstab entry keydirectory, create_crypto_blk_dev 'userdata', then mount /data.
# RACE (sesi #260): keystore2 hanya "running" saat trigger (fork), BUKAN "registered".
# vold sempat panggil keystore2 14ms SEBELUM 'Successfully registered' -> lazy-AIDL
# start gagal -> vold hang di binder_wait (vdc-mount-all running selamanya).
# Fix: sleep dulu agak keystore2 yang mestinya sudah registered+negotiated setelah 3s.
service vdc-mount-all /system/bin/sh -c 'sleep 3; exec /crypto/bin/sys/vdc cryptfs mountFstab /dev/block/by-name/userdata /data false ""'
    user root
    group root
    disabled
    oneshot
    setenv LD_LIBRARY_PATH /crypto/lib/system
    seclabel u:r:recovery:s0

service crypto-diag /system/bin/sh /crypto/bin/sys/crypto_diag.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0