# Full rombak: keystore2 A12 (TWRP 12.1 build) runs from its
# own init file with class early_hal (started at late-init), exactly like
# referensi A15+UMS9230 working decrypt. The A15 keystore2
# (crypto/bin/sys/keystore2) is gone; TWRP 12.1 libtwrpcrypto speaks AIDL V1.
service keystore2 /system/bin/keystore2 /data/misc/keystore
    class early_hal
    user keystore
    group keystore readproc log
    rlimit memlock unlimited unlimited
    seclabel u:r:recovery:s0
