# A12.1 built-in keystore2 -- ENABLED.
#
# Why this one and not the A15 keystore2 (/crypto/bin/sys/keystore2):
#   * TWRP 12.1 libtwrpcrypto speaks android.system.keystore2 AIDL V1
#     (system/bin/keystore2 here is the A12 "android.system.keystore2-V1-rust"
#     build; see its NEEDED libs libkeystore2_vintf_cpp.so / libkm_compat_service.so).
#     The A15 binary is V4 and its binder is rejected by TWRP's A12 libbinder
#     ("E Stability: Can only set known stability, not 0." -> connect fails ->
#     Decrypt_FBE_DE() can never install the storage key).
#   * This binary was previously disabled because it links libvintf@4.0
#     (kMetaVersion=4.0) which rejected the stock A15 VINTF trees (framework
#     manifest v8.0 / device manifest v5.0) with
#     "getDeviceHalManifest -22 (Unrecognized manifest.version)" -> SIGSEGV
#     crash-loop.  The baked trees have since been downgraded to meta-version
#     1.0 (framework) / 4.0 (device) so libvintf@4.0 parses them cleanly.
#   * It also no longer races an A15 keystore2: keymint_unisoc.rc starts THIS
#     service and no longer starts keystore2-unisoc.
#
# DB dir = /crypto/keystore2 (RAM, see early-init mkdir). The stock
# /data/misc/keystore is fscrypt-DE and unmounted at start -> sqlite panic
# (live-proven). RAM DB is a throwaway session store only; key material for
# CE unlock flows live in /metadata + spblob and go through keymint.
service keystore2 /system/bin/keystore2 /crypto/keystore2
    user root
    group root readproc log
    rlimit memlock unlimited unlimited
    disabled
    setenv LD_LIBRARY_PATH /system/lib64
    seclabel u:r:recovery:s0
