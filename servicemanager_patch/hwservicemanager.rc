on init
    start hwservicemanager

service hwservicemanager /system/bin/hwservicemanager
    user root
    group root
    onrestart setprop hwservicemanager.ready false
    disabled
    seclabel u:r:recovery:s0
    # DRAFT 1 (2026-09-03): use the A15 lib set so libvintf/libbinder understand the
    # A15 keymint/keystore2/vold AIDL interfaces. Stock A12.1 ramdisk libvintf
    # rejected IKeyMintDevice/default => keymint addService SIGABRT => no ICE => /data 0MB.
    # system_root (stock A15 system) mounted ro at late-init; earlier boot still
    # falls back to ramdisk A12.1 libs, then hal_boot restart picks up A15.
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/system/lib64/a15:/vendor/lib64