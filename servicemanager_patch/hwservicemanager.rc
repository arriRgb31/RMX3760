on init
    start hwservicemanager

service hwservicemanager /system/bin/hwservicemanager
    user root
    group root
    onrestart setprop hwservicemanager.ready false
    disabled
    seclabel u:r:recovery:s0
    # FINAL (2026-09-04): the baked A15 keymint/keystore2/vold speak A15 AIDL/binder.
    # Point this manager at the A15 libvintf/libbinder bundle so it accepts their
    # addService (A12.1 ramdisk libvintf rejected IKeyMintDevice/default => SIGABRT).
    # The bundle lives at RAMDISK ROOT /crypto/lib/man so it survives the late
    # /system overlay (stock A15 system mounted ro). GUI stays on A12.1.
    setenv LD_LIBRARY_PATH /crypto/lib/man