on init
    start vndservicemanager

service vndservicemanager /system/bin/vndservicemanager /dev/vndbinder
    user root
    group root readproc
    writepid /dev/cpuset/system-background/tasks
    shutdown critical
    disabled
    seclabel u:r:recovery:s0
    # FINAL (2026-09-04): vndbinder (used by keymint/gatekeeper addService) must
    # share the A15 binder wire protocol with the baked A15 keymint binary.
    # Bundle at RAMDISK ROOT /crypto/lib/man survives the /system overlay. GUI A12.1.
    setenv LD_LIBRARY_PATH /crypto/lib/man