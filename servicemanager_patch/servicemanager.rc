on init
    start servicemanager

service servicemanager /system/bin/servicemanager
    user root
    group root readproc
    disabled
    seclabel u:r:recovery:s0
    # servicemanager needs the A15 libbinder (ConnectionInfo symbol) at exec time.
    # /system gets overlaid by the stock partition late in boot, so the A15 lib
    # bundle lives at RAMDISK ROOT /crypto/lib/man (never shadowed). The TWRP GUI
    # (recovery) keeps A12.1 libs; only this process uses the bundle.
    setenv LD_LIBRARY_PATH /crypto/lib/man